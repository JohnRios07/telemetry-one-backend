TELEMETRY_ONE_ENV=testing
TELEMETRY_ONE_ADDR=:8080
TELEMETRY_ONE_AI_PROVIDER=fake
TELEMETRY_ONE_AI_MODEL=gpt-4o-mini

# Postgres testing persistence. The Docker Compose service reads POSTGRES_* and
# the backend uses the Docker-internal hostname `postgres`.
POSTGRES_USER=telemetry
POSTGRES_PASSWORD=change-me-in-github-secret
POSTGRES_DB=telemetry_one
TELEMETRY_ONE_DATABASE_URL=postgres://telemetry:change-me-in-github-secret@postgres:5432/telemetry_one?sslmode=disable

# OpenRouter — set real values for production AI analysis
# TELEMETRY_ONE_OPENROUTER_API_KEY=sk-or-v1-...
# TELEMETRY_ONE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# TELEMETRY_ONE_OPENROUTER_HTTP_REFERER=https://github.com/JohnRios07/telemetry-one-backend
# TELEMETRY_ONE_OPENROUTER_TITLE=Telemetry One Backend

# Admin — set to require auth on GET /api/v1/admin/ingest-stats
# TELEMETRY_ONE_ADMIN_TOKEN=change-me
